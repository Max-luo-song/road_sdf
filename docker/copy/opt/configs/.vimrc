set nu
set hlsearch
set tabstop=2
set shiftwidth=2
set expandtab
autocmd FileType cpp,c,h,hpp setlocal tabstop=2 shiftwidth=2 softtabstop=2
autocmd FileType python setlocal tabstop=4 shiftwidth=4 softtabstop=4
syntax on
set autoindent
set smartindent
set cindent
set showmode
set showcmd
set encoding=utf-8
set fileencoding=utf-8
